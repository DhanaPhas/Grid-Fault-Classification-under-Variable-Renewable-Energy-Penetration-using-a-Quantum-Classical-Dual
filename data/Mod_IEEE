    try:
        sc.calc_sc(net, bus=fault_bus, fault=fault_type, case=case, branch_results=True, rf_ohm=rf_ohm)
    except TypeError:
        try:
            sc.calc_sc(net, bus=fault_bus, fault=fault_type, case=case, branch_results=True)
        except Exception:
            return None
    except Exception:
        return None

    if net.res_bus_sc.empty or net.res_line_sc.empty:
        return None
    return extract_monitored_line_current_features(net, net.res_line_sc, "ikss_ka", monitored_buses)


